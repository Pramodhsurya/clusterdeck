{
    "defwidget@explorer": {
        "display:order": -6,
        "icon": "folder-tree",
        "label": "explorer",
        "description": "Reopen the file explorer if you closed it",
        "blockdef": {
            "meta": {
                "view": "cdexplorer",
                "clusterdeck:zone": "explorer"
            }
        }
    },
    "defwidget@editor": {
        "display:order": -5.5,
        "icon": "file-pen",
        "label": "editor",
        "description": "Reopen the file editor if you closed it",
        "blockdef": {
            "meta": {
                "view": "cdeditor",
                "clusterdeck:zone": "editor"
            }
        }
    },
    "defwidget@terminal": {
        "display:order": -5,
        "icon": "square-terminal",
        "label": "terminal",
        "blockdef": {
            "meta": {
                "view": "term",
                "controller": "shell"
            }
        }
    },
    "defwidget@files": {
        "display:order": -4,
        "icon": "folder",
        "label": "files",
        "blockdef": {
            "meta": {
                "view": "preview",
                "file": "~"
            }
        }
    },
    "defwidget@web": {
        "display:order": -3,
        "icon": "globe",
        "label": "web",
        "blockdef": {
            "meta": {
                "view": "web"
            }
        }
    },
    "defwidget@sysinfo": {
        "display:order": -2,
        "icon": "chart-line",
        "label": "sysinfo",
        "blockdef": {
            "meta": {
                "view": "sysinfo"
            }
        }
    },
    "defwidget@processviewer": {
        "display:order": -1,
        "icon": "list-tree",
        "label": "processes",
        "blockdef": {
            "meta": {
                "view": "processviewer"
            }
        }
    },
    "cdapp@k9s": {
        "display:order": 10,
        "icon": "dharmachakra",
        "label": "k9s",
        "description": "k9s — pick a Kubernetes cluster to open it against",
        "blockdef": {
            "meta": {
                "view": "term",
                "controller": "cmd",
                "cmd": "k9s",
                "cmd:login": true,
                "cdapp:kube": true
            }
        }
    },
    "cdapp@lazygit": {
        "display:order": 11,
        "icon": "code-branch",
        "label": "lazygit",
        "description": "lazygit — a terminal UI for git",
        "blockdef": {
            "meta": {
                "view": "term",
                "controller": "cmd",
                "cmd": "lazygit",
                "cmd:login": true
            }
        }
    },
    "cdapp@htop": {
        "display:order": 12,
        "icon": "gauge-high",
        "label": "htop",
        "description": "htop — interactive process viewer",
        "blockdef": {
            "meta": {
                "view": "term",
                "controller": "cmd",
                "cmd": "htop",
                "cmd:login": true
            }
        }
    }
}
